name: Plugin checks
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        php: ['7.4', '8.0', '8.1', '8.2', '8.3', '8.4']
    steps:
      - uses: actions/checkout@v4
      - uses: shivammathur/setup-php@v2
        with:
          php-version: ${{ matrix.php }}
          coverage: none
      - name: PHP syntax
        run: find custom-html-snippets -name '*.php' -print0 | xargs -0 -n1 php -l
      - name: Simulated WordPress tests
        run: |
          php tests/run-tests.php
          php tests/integration.php
          php tests/regression.php
          php tests/compatibility.php
  javascript-and-package:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: JavaScript syntax
        run: for file in custom-html-snippets/assets/js/*.js; do node --check "$file"; done
      - name: Build installable plugin
        run: zip -qr custom-html-snippets-current.zip custom-html-snippets
      - uses: actions/upload-artifact@v4
        with:
          name: custom-html-snippets-installable
          path: custom-html-snippets-current.zip

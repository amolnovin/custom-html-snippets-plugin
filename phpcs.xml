<?xml version="1.0"?>
<ruleset name="Custom HTML Snippets">
    <description>استاندارد کدنویسی وردپرس برای افزونه قطعه کدهای سفارشی.</description>

    <file>custom-html-snippets</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/js/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="WordPress">
        <!-- افزونه عمداً کد خام کاربر را چاپ می‌کند؛ این موارد جداگانه بررسی شده‌اند. -->
        <exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>
        <exclude name="Squiz.PHP.Eval.Discouraged"/>
        <!-- نام فایل‌ها از الگوی class-chs-*.php پیروی می‌کند. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="custom-html-snippets"/>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="5.8"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
